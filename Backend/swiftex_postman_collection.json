{
  "info": {
    "name": "SwiftEx API",
    "description": "Postman collection for the SwiftEx Carrier-Agnostic Tracking Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "internalTrackingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Misc",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@swiftex.local\",\n  \"password\": \"SecurePassword123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@swiftex.local\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "Create Shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data.shipment) {",
                  "    pm.collectionVariables.set(\"internalTrackingId\", response.data.shipment.internalTrackingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrier\": \"dhl\",\n  \"carrierTrackingNumber\": \"1234567890\",\n  \"metadata\": {\n    \"description\": \"Electronics Package\",\n    \"sender\": {\n      \"name\": \"Tech Store\"\n    },\n    \"receiver\": {\n      \"name\": \"John Doe\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            }
          }
        },
        {
          "name": "Create Multi-Leg Shipment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrier\": \"dhl\",\n  \"carrierTrackingNumber\": \"DHL-123\",\n  \"legs\": [\n    {\n      \"carrier\": \"dhl\",\n      \"carrierTrackingNumber\": \"DHL-123\",\n      \"legOrder\": 0\n    },\n    {\n      \"carrier\": \"fedex\",\n      \"carrierTrackingNumber\": \"111111111111\",\n      \"legOrder\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            }
          }
        },
        {
          "name": "List Shipments",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shipments?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "carrier",
                  "value": "dhl",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "IN_TRANSIT",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Shipment by ID (Internal)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shipments/{{internalTrackingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "{{internalTrackingId}}"
              ]
            }
          }
        },
        {
          "name": "Manual Poll (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shipments/{{internalTrackingId}}/poll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "{{internalTrackingId}}",
                "poll"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Public Tracking",
      "item": [
        {
          "name": "Public Tracking View",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/track/{{internalTrackingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "track",
                "{{internalTrackingId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "DHL UTAPI Webhook (Push)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-dhl-signature",
                "value": "replace-with-valid-signature",
                "description": "HMAC-SHA256 signature using your DHL_WEBHOOK_SECRET"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipment\": {\n    \"trackingNumber\": \"1234567890\",\n    \"events\": [\n      {\n        \"timestamp\": \"2024-06-15T10:30:00Z\",\n        \"location\": {\n          \"address\": {\n            \"addressLocality\": \"Berlin\"\n          }\n        },\n        \"description\": \"Shipment has departed from a DHL facility\",\n        \"statusCode\": \"transit\"\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/dhl",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "dhl"
              ]
            }
          }
        }
      ]
    }
  ]
}
