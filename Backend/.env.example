# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/swiftex

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── DHL (UTAPI v2) ─────────────────────────────────
DHL_API_KEY=your-dhl-api-key
DHL_WEBHOOK_SECRET=your-dhl-webhook-signing-secret
DHL_BASE_URL=https://api-eu.dhl.com

# ── FedEx ───────────────────────────────────────────
FEDEX_API_KEY=your-fedex-api-key
FEDEX_SECRET_KEY=your-fedex-secret-key
FEDEX_BASE_URL=https://apis-sandbox.fedex.com

# ── Tracking / Caching ─────────────────────────────
TRACKING_FRESHNESS_THRESHOLD_MINUTES=15
FEDEX_POLL_CRON=*/10 * * * *
FEDEX_POLL_BATCH_SIZE=30
